# ── Frontend (Vite) ───────────────────────────────────────────────────────────
VITE_API_BASE_URL=/api/v1
VITE_USE_MOCKS=false

# ── Database (Neon / Postgres) ────────────────────────────────────────────────
# Get this from your Neon dashboard → Connection string → Pooled connection
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require&channel_binding=require
POSTGRES_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require&channel_binding=require

# ── AI API Keys (SERVER-SIDE ONLY — never use VITE_ prefix for these) ────────
# IMPORTANT: These must NOT have the VITE_ prefix or they will be exposed in the browser bundle.
# These are used only in Vercel serverless functions (api/ directory).

# NVIDIA NIM — https://build.nvidia.com
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxx

# AI/ML API — https://aimlapi.com
AIML_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
