generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String         @id @default(uuid())
  email        String         @unique
  username     String         @unique
  passwordHash String
  role         String         @default("developer")
  devApiKey    String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  auditHistory AuditHistory[]
  projects     Project[]

  @@map("users")
}

model Project {
  id                  String               @id @default(uuid())
  name                String
  repoUrl             String?
  stage               String               @default("core_audit")
  readinessScore      Int                  @default(0)
  userId              String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  auditHistory        AuditHistory[]
  blueprint           Blueprint?
  coreAudit           CoreAudit?
  impactAudit         ImpactAudit?
  migrationReport     MigrationReport?
  user                User?                @relation(fields: [userId], references: [id])
  readinessAssessment ReadinessAssessment?
  rustExports         RustExport[]
  transformations     Transformation[]
  uploadedSources     UploadedSource[]

  @@map("projects")
}

model UploadedSource {
  id        String   @id @default(uuid())
  projectId String
  fileName  String
  rawCode   String
  language  String   @default("java")
  astData   Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("uploaded_sources")
}

model CoreAudit {
  id                  String   @id @default(uuid())
  projectId           String   @unique
  architectureSummary String
  detectedStack       Json
  deprecatedUsages    Json
  dependencyGraph     Json
  diagrams            Json
  confidence          Float    @default(0.9)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  project             Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("core_audits")
}

model ImpactAudit {
  id              String   @id @default(uuid())
  projectId       String   @unique
  apiSurface      Json
  databaseImpacts Json
  configImpacts   Json
  dependencyRisks Json
  blastRadius     Json
  confidence      Float    @default(0.9)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("impact_audits")
}

model ReadinessAssessment {
  id                 String   @id @default(uuid())
  projectId          String   @unique
  overallScore       Int      @default(0)
  breakdown          Json
  consensusIteration Int      @default(1)
  consensusConflicts Json
  unifiedConfidence  Float    @default(0.9)
  shouldIterateAgain Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  project            Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("readiness_assessments")
}

model Blueprint {
  id        String          @id @default(uuid())
  projectId String          @unique
  version   Int             @default(1)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  steps     BlueprintStep[]
  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("blueprints")
}

model BlueprintStep {
  id              String           @id @default(uuid())
  blueprintId     String
  stepNumber      Int              @default(1)
  fileOrModule    String
  whatChanges     String
  why             String
  targetPattern   String
  riskLevel       String           @default("medium")
  dependsOn       String[]         @default([])
  status          String           @default("pending")
  rejectionReason String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  blueprint       Blueprint        @relation(fields: [blueprintId], references: [id], onDelete: Cascade)
  transformations Transformation[]

  @@map("blueprint_steps")
}

model Transformation {
  id                  String         @id @default(uuid())
  projectId           String
  stepId              String?
  status              String         @default("completed")
  rawJavaCode         String
  transformedRustCode String
  errorDetail         String?
  modelUsed           String         @default("meta/llama-3.1-70b-instruct")
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  project             Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  step                BlueprintStep? @relation(fields: [stepId], references: [id])

  @@map("transformations")
}

model MigrationReport {
  id            String   @id @default(uuid())
  projectId     String   @unique
  totalUnits    Int      @default(0)
  filesModified String[] @default([])
  summaryStats  Json
  diffEntries   Json
  rollbackPlan  String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("migration_reports")
}

model RustExport {
  id               String   @id @default(uuid())
  projectId        String
  exportName       String
  combinedRustCode String
  cargoTomlContent String
  createdAt        DateTime @default(now())
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("rust_exports")
}

model AuditHistory {
  id        String   @id @default(uuid())
  userId    String?
  projectId String?
  action    String
  metadata  Json
  createdAt DateTime @default(now())
  project   Project? @relation(fields: [projectId], references: [id])
  user      User?    @relation(fields: [userId], references: [id])

  @@map("audit_history")
}
